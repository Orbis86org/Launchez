// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Token {
  id                 Int      @id @default(autoincrement())
  name               String?  @map("name")
  tokenId            String?  @unique @map("token_id")
  ticker             String?  @map("ticker")
  memo               String?  @map("memo")
  description        String?  @map("description")
  walletAddress      String?  @map("wallet_address")
  hashscanUrl        String?  @map("hashscan_url")
  bondingCurveSupply String?  @map("bonding_curve_supply")
  bondingCurveHbar   String?  @map("bonding_curve_hbar")
  liquidityPoolLink  String?  @map("liquidity_pool_link")
  image              String?  @map("image") // Optional field for the image path
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("tokens")
}

model Threads {
  id         Int       @id @default(autoincrement())
  token_id   String
  title      String
  content    String
  author     String
  created_at DateTime  @default(now())
  replies    Replies[]
}

model Replies {
  id         Int      @id @default(autoincrement())
  thread_id  Int
  content    String
  author     String
  created_at DateTime @default(now())

  threads Threads @relation(fields: [thread_id], references: [id])
}
